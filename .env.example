# GEMINI_API_KEY: Required for Gemini AI API calls (server and client).
# No Vercel, adicione em: Project Settings -> Environment Variables
# Obtenha em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# No Vercel: https://seu-projeto.vercel.app (ou gerado automaticamente pela Vercel)
APP_URL="MY_APP_URL"

# Configuração do Firebase Firestore (Opcional - valores de fallback já incluídos no código)
FIREBASE_PROJECT_ID="gen-lang-client-0760041056"

